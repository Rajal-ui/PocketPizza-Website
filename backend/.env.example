NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:pass@localhost:5432/pokket_pizza
JWT_SECRET=
JWT_ISSUER=pokket-pizza
JWT_AUDIENCE=pokket-pizza-admin
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5500,http://localhost:5501
# Shop map-pin coordinates (server-side only, never exposed to the browser).
# Used for the straight-line delivery fee: free within 1.5 km, ₹30 beyond.
# Replace with the actual pin before deploying a different shop location.
SHOP_LATITUDE=18.456165955627945
SHOP_LONGITUDE=73.86959266088635
# WhatsApp via a Coexistence-capable BSP (YCloud recommended).
# Create the API key in the BSP dashboard -> Settings -> API Keys.
BSP_API_KEY=
# YCloud: https://api.ycloud.com/v2/whatsapp/messages
BSP_API_ENDPOINT=https://api.ycloud.com/v2/whatsapp/messages
# WhatsApp Business sender number in E.164, e.g. +918788197404
BSP_WHATSAPP_NUMBER=+918788197404
# Approved utility template name, e.g. pokket_pizza_order_confirmation
CUSTOMER_TEMPLATE_NAME=pokket_pizza_order_confirmation
LOG_LEVEL=info
